# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
/dist/

# Virtualenv / uv
.venv/

# Frontend (setup webapp). node_modules is never committed; the built SPA under
# src/lsm/setup/web/dist IS committed so the image needs no Node at runtime.
web/setup/node_modules/
web/setup/dist/
# The `assets/` rule below (downloaded model weights) is unanchored and would
# otherwise swallow the SPA's built bundle dir; keep the committed SPA tracked.
!src/lsm/setup/web/dist/
!src/lsm/setup/web/dist/assets/

# Environment
.env
.env.*
!.env.example

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Downloaded model assets (large; fetched via lsm-download). Anchored to the
# repo root so it does not match nested dirs like the SPA's built assets/.
/assets/

# TLS certificates / keys (never commit real ones)
nginx/certs/*
!nginx/certs/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
