# --- llm-session-manager configuration ---
# All variables are prefixed with LSM_ and can also be set via a .env file.

# Redis connection (shared by API + ARQ worker).
LSM_REDIS_URL=redis://localhost:6379/0

# Upstream OpenAI-compatible model server (vLLM / Ollama / llama.cpp / etc).
LSM_MODEL_BASE_URL=http://localhost:8000/v1
LSM_MODEL_API_KEY=not-needed
LSM_DEFAULT_MODEL=local-model

# Model assets (HuggingFace downloads for use with vLLM). Downloaded models are
# written under LSM_MODELS_DIR (vLLM-ready) using the LSM_HF_CACHE_DIR cache.
# In Docker these are set to /app/assets/... and bind-mounted to ./assets.
LSM_ASSETS_DIR=assets
LSM_HF_CACHE_DIR=assets/hf-cache
LSM_MODELS_DIR=assets/models
# Optional HuggingFace token for gated/private repos (used by lsm-download).
#HF_TOKEN=

# --- Bundled vLLM model server (optional; DGX Spark `spark` profile) ---------
# Enable with: docker compose --profile spark up -d --build
# Serves a model on a single NVIDIA DGX Spark (GB10/sm_121a, ARM64). Requires
# the NVIDIA Container Toolkit and the model pre-downloaded via lsm-download:
#   uv run lsm-download Pilcothink/Qwen3.8-27B-MixedInt4-AutoRound
# To route the app through it, uncomment these two lines (overriding the
# LSM_MODEL_* values above) so api/worker talk to the vllm service in-network:
#LSM_MODEL_BASE_URL=http://vllm:8000/v1
#LSM_DEFAULT_MODEL=qwen3.8-27b
#
# vLLM image for the Spark (community image tracking upstream vLLM).
VLLM_IMAGE=ghcr.io/timothystewart6/vllm-gb10:latest
# Local dir (mounted from ./assets) or a HF repo id for vLLM to serve.
VLLM_MODEL_PATH=/app/assets/models/Pilcothink/Qwen3.8-27B-MixedInt4-AutoRound
# Stable model id advertised to clients (must match LSM_DEFAULT_MODEL above).
VLLM_SERVED_MODEL_NAME=qwen3.8-27b
# Host address + port the vLLM port is published on (loopback by default).
VLLM_BIND_HOST=127.0.0.1
VLLM_PORT=8000
# --- Single-Spark recipe knobs (defaults follow the model author's recipe) ---
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_KV_CACHE_DTYPE=fp8
VLLM_REASONING_PARSER=qwen3
VLLM_TOOL_CALL_PARSER=qwen3_coder
# Context window. The model supports up to 1010000; 262144 is a safe default.
VLLM_MAX_MODEL_LEN=262144
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=10

# HTTP client timeouts (seconds).
LSM_CONNECT_TIMEOUT_S=10
LSM_REQUEST_TIMEOUT_S=300

# Worker concurrency + retry behaviour.
LSM_WORKER_MAX_JOBS=10
LSM_WORKER_JOB_TIMEOUT_S=600
LSM_MAX_RETRIES=3
LSM_RETRY_BACKOFF_BASE_S=2.0

# Data lifetimes (seconds).
LSM_JOB_TTL_S=86400
LSM_TOKEN_BUFFER_TTL_S=3600

# Synchronous request behaviour.
LSM_SYNC_WAIT_TIMEOUT_S=300

# API server.
# LSM_API_HOST is the address uvicorn binds *inside* the container (leave as-is).
LSM_API_HOST=0.0.0.0
LSM_API_PORT=8080
LSM_LOG_LEVEL=INFO

# Host address the published API port is bound to. Defaults to loopback so the
# API is never exposed on the LAN. Put a reverse proxy in front for remote
# access; only change this if you understand the exposure it creates.
LSM_BIND_HOST=127.0.0.1

# --- First-run setup webapp (batteries-included wizard) ---------------------
# The setup service (docker compose up setup, or `uv run lsm-setup`) serves a
# configuration wizard that writes this .env, TLS certs, and downloads models.
# It listens on 0.0.0.0:8989 inside the container. Because first-run setup must
# be reachable before any reverse proxy exists, the published port defaults to
# all interfaces -- restrict LSM_SETUP_BIND_HOST once you no longer need it.
LSM_SETUP_HOST=0.0.0.0
LSM_SETUP_PORT=8989
LSM_SETUP_BIND_HOST=0.0.0.0
# Admin account created by the wizard. The stack is "configured" (and the wizard
# sealed) once LSM_ADMIN_PASSWORD_HASH is set; it is a bcrypt hash written by the
# wizard -- do not set it by hand. Afterwards the webapp requires this login.
LSM_ADMIN_USER=admin
#LSM_ADMIN_PASSWORD_HASH=

# --- Bundled nginx reverse proxy (optional; comment out the service to disable) ---
# Two TLS vhosts (name-based). Both hostnames must resolve to this host and be
# covered by the certificate (use a SAN/wildcard cert for both).
# vhost 1: the session-manager API (job persistence, retries, reconnect).
NGINX_SM_SERVER_NAME=localhost
# vhost 2: the raw OpenAI-compatible model server (direct passthrough).
NGINX_OPENAI_SERVER_NAME=openai.localhost
# Upstream model server nginx proxies the raw OpenAI vhost to (host:port).
NGINX_OPENAI_UPSTREAM=host.docker.internal:1234
# Host ports nginx publishes. 443 is TLS; 80 redirects to 443.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Shared certificate + key paths *inside the nginx container* (mounted from
# ./nginx/certs). A single SAN/wildcard cert covering both hostnames uses these.
# Run ./nginx/generate-self-signed-cert.sh to create these for local testing.
NGINX_TLS_CERT_FILE=/etc/nginx/certs/server.crt
NGINX_TLS_KEY_FILE=/etc/nginx/certs/server.key
# Optional: use a SEPARATE cert per vhost. Each of these defaults to the shared
# NGINX_TLS_* above, so leave them unset unless you want distinct certs.
#NGINX_SM_TLS_CERT_FILE=/etc/nginx/certs/sm.crt
#NGINX_SM_TLS_KEY_FILE=/etc/nginx/certs/sm.key
#NGINX_OPENAI_TLS_CERT_FILE=/etc/nginx/certs/openai.crt
#NGINX_OPENAI_TLS_KEY_FILE=/etc/nginx/certs/openai.key
